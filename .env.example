# 複製本檔為 .env 後填入實際值（.env 已在 .gitignore 中，不會被提交）

# --- OpenAI API（scripts/inference_openai.py）---
OPENAI_API_KEY=

# --- DGX Spark SSH tunnel（scripts/inference.py）---
# 若已用系統 SSH 自行建立 tunnel 並加上 --no-tunnel，可不填
DGX_SSH_HOST=
DGX_SSH_PORT=22
DGX_SSH_USER=
DGX_SSH_PASSWORD=
# DGX 上 LiteLLM 監聽的 port
DGX_REMOTE_PORT=4000
